### get test_events

index=cadets earliest=0 record_type=Event
| eval event_epoch=strptime(event_time, "%Y-%m-%dT%H:%M:%S.%6NZ")
| where
    (event_epoch >= strptime("2018-04-06T11:00:00Z", "%Y-%m-%dT%H:%M:%SZ")
     AND event_epoch < strptime("2018-04-06T13:00:00Z", "%Y-%m-%dT%H:%M:%SZ"))
 OR
    (event_epoch >= strptime("2018-04-09T13:00:00Z", "%Y-%m-%dT%H:%M:%SZ")
     AND event_epoch < strptime("2018-04-09T15:30:00Z", "%Y-%m-%dT%H:%M:%SZ"))
 OR (event_epoch >= strptime("2018-04-10T12:00:00Z", "%Y-%m-%dT%H:%M:%SZ")
     AND event_epoch < strptime("2018-04-10T13:30:00Z", "%Y-%m-%dT%H:%M:%SZ"))
 OR (event_epoch >= strptime("2018-04-11T14:45:00Z", "%Y-%m-%dT%H:%M:%SZ")
     AND event_epoch < strptime("2018-04-11T16:30:00Z", "%Y-%m-%dT%H:%M:%SZ"))
 OR (event_epoch >= strptime("2018-04-12T13:45:00Z", "%Y-%m-%dT%H:%M:%SZ")
     AND event_epoch < strptime("2018-04-12T15:30:00Z", "%Y-%m-%dT%H:%M:%SZ"))
 OR (event_epoch >= strptime("2018-04-13T08:45:00Z", "%Y-%m-%dT%H:%M:%SZ")
     AND event_epoch < strptime("2018-04-13T10:00:00Z", "%Y-%m-%dT%H:%M:%SZ"))
| stats count AS test_events


### get train_events  (Set time and remove evals to speed it up)

index=cadets earliest=0 record_type=Event
| eval event_epoch=strptime(event_time, "%Y-%m-%dT%H:%M:%S.%6NZ")
| where event_epoch >= strptime("2018-04-02T00:00:00Z", "%Y-%m-%dT%H:%M:%SZ")
    AND event_epoch < strptime("2018-04-06T00:00:00Z", "%Y-%m-%dT%H:%M:%SZ")
| stats count AS train_events

